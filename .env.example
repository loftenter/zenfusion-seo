# DataForSEO API (required — pay-as-you-go)
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# ScrapeOwl API (for JS-rendered page scraping)
SCRAPEOWL_API_KEY=your_key

# Perplexity Sonar API (for AEO testing — ~$0.005/query)
PERPLEXITY_API_KEY=your_key

# Keywords Everywhere (prepaid credits — keyword volume/CPC)
KEYWORDS_EVERYWHERE_API_KEY=your_key

# InfraNodus (entity extraction + knowledge graph)
INFRANODUS_API_KEY=your_key

# IndexBolt (Google indexing for backlinks — credits)
INDEXBOLT_API_KEY=your_key

# Google PageSpeed Insights (free, optional — higher quota with key)
PSI_API_KEY=your_key

# Omega Indexer (fallback when IndexBolt fails)
OMEGA_API_KEY=your_key

# Google Search Console (OAuth — see gsc_helper.py for setup)
# GSC credentials at ~/.hermes/google_token.json
